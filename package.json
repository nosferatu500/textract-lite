{
  "name": "@nosferatu500/textract-lite",
  "version": "9.0.0",
  "type": "module",
  "homepage": "https://github.com/nosferatu500/textract-lite",
  "description": "Extracting text from .docx and plain text files.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "author": {
    "name": "Vitalii Shvetsov",
    "email": "vitalya199529@gmail.com",
    "url": "https://github.com/nosferatu500"
  },
  "contributors": [
    {
      "name": "David Bashford",
      "email": "dbashford@hotmail.com",
      "url": "https://github.com/dbashford"
    }
  ],
  "engines": {
    "node": ">=24.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nosferatu500/textract-lite"
  },
  "scripts": {
    "lint": "eslint . --cache",
    "test": "mocha",
    "clean": "rimraf dist build package",
    "docs": "typedoc --entryPoints src/index.ts",
    "clean-types": "rimraf dist/extractors/docx.d.ts && rimraf dist/extractors/text.d.ts && rimraf dist/extract.d.ts && rimraf dist/utils.d.ts",
    "build": "npm run clean && tsc -p tsconfig.json && npm run clean-types"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.11",
    "html-entities": "^2.6.0",
    "iconv-lite": "^0.7.3",
    "jschardet": "^3.1.4",
    "mime": "^4.1.0",
    "xpath": "^0.0.34",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.13.3",
    "@types/yauzl": "^3.4.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.1",
    "mocha": "^11.8.0",
    "rimraf": "^6.1.3",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "textract-lite",
    "textract",
    "extract",
    "extraction",
    "docx",
    "txt",
    "text",
    "esm"
  ]
}
